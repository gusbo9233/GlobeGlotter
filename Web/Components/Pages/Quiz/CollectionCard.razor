@inject NavigationManager Navigation 

<div class="collection-card-shell">
    <MudCard Class="collection-card" 
            Outlined="true"
            @onclick="OpenCollection">
        <MudCardContent>
            <MudText Typo="Typo.overline" Color="Color.Info">
                Collection
            </MudText>
            <MudText Typo="Typo.h6">@Collection.Name</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Collection.Collections.Count collections
                @Collection.Quizzes.Count quizzes
            </MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Text" Color="Color.Error"
                        OnClick="() => OnDelete.InvokeAsync(Collection.Id)">
                    Delete
            </MudButton>
        </MudCardActions>
    </MudCard>    
</div>

@code {
    [Parameter, EditorRequired]
    public CollectionDto Collection {get; set;} = default!;

    private void OpenCollection(){
        Navigation.NavigateTo($"/library/{Collection.Id}");

    }

    [Parameter]
    public EventCallback<Guid> OnDelete {get; set;}
}
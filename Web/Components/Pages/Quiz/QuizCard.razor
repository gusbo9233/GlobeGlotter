
<div class="quiz-card-shell">
    <MudCard Class="quiz-card" Outlined="true">
        <MudCardContent>
            <MudText Typo = "Typo.overline" 
                    Color="Color.Success"
                    @onclick="GoToQuiz">
                Quiz 
            </MudText>
            <MudText Typo="Typo.h6">@Quiz.Name</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Quiz.Words.Count words
            </MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Text" Color="Color.Error"
                        OnClick="() => OnDelete.InvokeAsync(Quiz.Id)">
                    Delete 
            </MudButton>
        </MudCardActions>
    </MudCard>
</div>

@code {
    [Parameter, EditorRequired]
    public QuizDto Quiz {get; set;} = default!;

    [Parameter]
    public EventCallback<Guid> OnDelete {get; set;}

    private void GoToQuiz(){
        //Navigation.NavigateTo($"/")
    }
}